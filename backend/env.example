# Copy this file to backend/.env and fill in the blank values.

# Local Docker Compose database
DATABASE_URL=postgresql://notebuddy:notebuddy@db:5432/notebuddy

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET_NAME=
SQS_QUEUE_URL=

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=

# OpenAI
OPENAI_API_KEY=
